generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Market {
  id              String            @id @default(uuid())
  address         String            @unique // PublicKey on Solana
  symbol          String            // e.g. "AAPLx/USDC"
  strike          Float
  expiry          DateTime
  totalLiquidity  Float             @default(0)
  premiumAsk      Float             @default(0)
  optionMint      String?           // Option SPL Token Mint
  underlyingMint  String?           // E.g. Wrapped SOL Mint
  quoteMint       String?           // USDC Mint
  type            String            @default("crypto") // "crypto" or "us_stocks"
  pythFeedId      String?           // Pyth Network Price Feed ID
  isSynthetic     Boolean           @default(false)
  network         String            @default("devnet") // "devnet" or "mainnet"
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  positions       OptionPosition[]
  trades          TradeHistory[]
}

model OptionPosition {
  id              String   @id @default(uuid())
  ownerAddress    String   // Solana wallet address
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id])
  quantity        Float
  positionType    String   // "WRITTEN" or "BOUGHT"
  network         String   @default("devnet") // "devnet" or "mainnet"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TradeHistory {
  id              String   @id @default(uuid())
  userAddress     String   // Solana wallet address
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id])
  action          String   // "WRITE" or "BUY"
  quantity        Float
  price           Float
  txSignature     String   @unique // Solana transaction signature
  network         String   @default("devnet") // "devnet" or "mainnet"
  createdAt       DateTime @default(now())
}

model SystemLog {
  id          String   @id @default(uuid())
  level       String
  message     String
  environment String   // "dev" or "prod"
  metadata    Json?
  createdAt   DateTime @default(now())
}
