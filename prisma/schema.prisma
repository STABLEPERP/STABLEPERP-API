generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Market {
  id              String            @id @default(uuid())
  address         String            @unique // PublicKey on Solana
  symbol          String            // e.g. "AAPLx/USDC"
  strike          Float
  expiry          DateTime
  totalLiquidity  Float             @default(0)
  premiumAsk      Float             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  positions       OptionPosition[]
  trades          TradeHistory[]
}

model OptionPosition {
  id              String   @id @default(uuid())
  ownerAddress    String   // Solana wallet address
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id])
  quantity        Float
  positionType    String   // "WRITTEN" or "BOUGHT"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TradeHistory {
  id              String   @id @default(uuid())
  userAddress     String   // Solana wallet address
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id])
  action          String   // "WRITE" or "BUY"
  quantity        Float
  price           Float
  txSignature     String   @unique // Solana transaction signature
  createdAt       DateTime @default(now())
}
